{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
			"ES2020",
			"DOM" // 添加 DOM 库支持 console
		],
		"sourceMap": true,
		"strict": false, // 临时关闭严格模式
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"src",
		"src/test"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}